# EntitleFlow NC — Environment Variables
# Copy this file to .env.local and fill in real values before running locally.
#
#   cp .env.example .env.local

# ---------- Public (safe for client bundles) ----------

# Canonical site URL — used in metadata, sitemap, robots.txt, and OG tags.
# Set to http://localhost:3000 for local dev. Set to your production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calendly booking URL shown after walkthrough form submission.
# Replace with your actual Calendly link.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/entitleflow-walkthrough

# Supabase public keys (safe for client-side auth flows)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps API key (client-side for map rendering)
# Get from: https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ---------- Server-only (NEVER prefix with NEXT_PUBLIC_) ----------

# Supabase project URL — used server-side by the lead capture API route.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — used server-side ONLY by app/api/leads/route.ts.
# This key has full database access. Never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps API key (server-side for geocoding endpoint)
# Same key as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY but kept server-only for geocoding route
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ---------- Vertex AI (AI Comment Classification & Review Summarization) ----------

# GCP project ID (required for Vertex AI - defaults to gravityclaw-488910)
GCP_PROJECT_ID=gravityclaw-488910

# Vertex AI location (defaults to us-central1)
VERTEX_AI_LOCATION=us-central1

# GCP service account credentials for Vertex AI
# Use the same credentials as GCS (see Google Cloud Storage section below)
# Vertex AI will use GOOGLE_APPLICATION_CREDENTIALS or GCP_SERVICE_ACCOUNT_KEY automatically

# ---------- Google Cloud Storage (Document Management) ----------

# GCP project ID (get from Google Cloud Console)
GCP_PROJECT_ID=gravityclaw-488910

# GCS bucket name for storing documents
GCS_BUCKET_NAME=entitleflow-documents

# GCP service account credentials - use ONE of these methods:
# Option 1: Point to a service account key JSON file (local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# Option 2: Inline JSON for Vercel deployment (recommended for production)
# Get from Google Cloud Console > Service Accounts > Create key > JSON
# Paste the entire JSON as a single-line string and set here:
GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ---------- Document AI Configuration ----------

# Document AI Processor ID
# Get from Google Cloud Console > Document AI > Processors
# Format: projects/{project-id}/locations/{location}/processors/{processor-id}
DOCUMENT_AI_PROCESSOR_ID=projects/gravityclaw-488910/locations/us/processors/your-processor-id

# Document AI location (default: us)
# Other options: eu, us, etc.
DOCUMENT_AI_LOCATION=us

# ---------- Email Integration ----------

# Resend API key — powers notification emails to internal team inboxes.
# Sends to: WalkthroughRequests@entitleflow.com (lead alerts)
#           Licenses@entitleflow.com (license change requests)
# Get your key at: https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000/month
RESEND_API_KEY=re_your-resend-api-key

# Shared secret for the inbound email webhook (/api/email/inbound).
# Generate with: openssl rand -hex 32
# Set the same value in Google Apps Script and in Vercel env vars.
INBOUND_EMAIL_SECRET=your-webhook-secret-here

# ---------- AI Enhancement Layer (OpenRouter / MiMo-v2-Pro) ----------

# OpenRouter API key — enables the MiMo-v2-Pro enhancement layer.
# When set, complex reasoning tasks (compliance analysis, resubmittal planning,
# project intelligence) use MiMo-v2-Pro via OpenRouter for deeper analysis.
# When NOT set, everything runs on Vertex AI / Gemini (GCP backbone).
#
# Get your key at: https://openrouter.ai/keys
# Pricing: $1/1M input tokens, $3/1M output tokens (context ≤256K)
OPENROUTER_API_KEY=your-openrouter-api-key

# ---------- Optional ----------

# Contact email displayed in the site footer (defaults to hello@entitleflownc.com in site-config.ts).
# NEXT_PUBLIC_CONTACT_EMAIL=hello@entitleflownc.com
